{
  "name": "claude-bridge",
  "version": "0.2.0",
  "private": true,
  "description": "claude-bridge — Claude Code 를 Telegram 으로 연결하는 MCP 채널 호스트 (Bun/TS). src/core 는 채널 무관, src/channels/<name> 은 채널별 구현.",
  "type": "module",
  "scripts": {
    "start": "bun run src/dispatcher.ts",
    "dev": "bun --hot run src/dispatcher.ts",
    "server": "bun run src/channels/telegram/server.ts",
    "cb": "bun run src/channels/cli/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "bin": {
    "cb": "bin/cb"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "grammy": "^1.30.0",
    "ink": "^5.0.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^18.3.0",
    "typescript": "^5.5.0"
  }
}
